# Cấu hình Nginx mẫu cho AutoCC trên DigitalOcean (Ubuntu)
# Lưu file vào: /etc/nginx/sites-available/autocc
# Kích hoạt: sudo ln -s /etc/nginx/sites-available/autocc /etc/nginx/sites-enabled/
# Test & Reload: sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name your-domain.com www.your-domain.com; # Thay bằng IP hoặc domain của bạn

    # Cho phép upload file video lớn (khớp với MAX_UPLOAD_MB trong .env)
    client_max_body_size 2048M;

    # (Tùy chọn) Bật mật khẩu bảo vệ truy cập nếu muốn dùng cá nhân/nội bộ
    # auth_basic "Restricted Access - AutoCC";
    # auth_basic_user_file /etc/nginx/.htpasswd;

    # ── Nén ────────────────────────────────────────────────────────────────
    # Backend đã tự nén (SelectiveGZipMiddleware) nên phần lớn response tới đây
    # đã có Content-Encoding và Nginx bỏ qua — không có chuyện nén hai lần.
    # Giữ khối này để bắt những gì backend không nén, ví dụ khi chạy sau một
    # phiên bản cũ hơn hoặc phục vụ file tĩnh trực tiếp.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 800;
    gzip_types text/plain text/css text/javascript application/javascript
               application/json image/svg+xml;

    # ── Cấu hình proxy dùng chung (location kế thừa) ────────────────────────
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Rỗng, không "close": SSE cần kết nối được giữ mở.
    proxy_set_header Connection '';

    location / {
        proxy_pass http://127.0.0.1:8000;

        # Buffering BẬT ở đây, khác với cấu hình cũ tắt cho toàn bộ site.
        # Tắt toàn cục nghĩa là mọi file tĩnh cũng đi thẳng từng chunk một,
        # và worker Python phải chờ client chậm nhất đọc xong mới rảnh.
        #
        # Hai luồng thật sự cần đẩy thẳng — SSE (/events) và video (/video) —
        # tự gửi header `X-Accel-Buffering: no`, Nginx tôn trọng header đó và
        # tắt buffering riêng cho chúng. Nhờ vậy ở đây không cần location regex
        # nào cả, và một route stream mới sẽ tự động đúng.
        proxy_buffering on;

        # Job AI chạy hàng chục phút; /mux giữ request mở suốt quá trình render.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        # Upload video vài GB: đẩy thẳng lên backend thay vì ghi tạm ra đĩa trước.
        proxy_request_buffering off;
    }
}
