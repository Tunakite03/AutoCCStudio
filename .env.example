# Local AI transcription
TRANSCRIPTION_PROVIDER=faster_whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Deepgram cloud transcription with speaker diarization.
# Set TRANSCRIPTION_PROVIDER=deepgram to make it the default in the UI.
DEEPGRAM_API_KEY=
DEEPGRAM_BASE_URL=https://api.deepgram.com
DEEPGRAM_MODEL=nova-3
DEEPGRAM_DIARIZE_MODEL=latest
DEEPGRAM_TIMEOUT_SECONDS=900

# Translation provider. "openai_compatible" works with Ollama, Mistral AI, OpenAI, LM Studio, etc.
TRANSLATION_PROVIDER=openai_compatible
# For Ollama (Local):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=[]
# LLM_MODEL=qwen2.5:7b
# For Mistral AI:
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=[your-mistral-api-key]
LLM_MODEL=mistral-small-latest
# Optional: use a separate chat model to detect speaker-turn boundaries.
# Leave empty to reuse LLM_MODEL.
SPEAKER_ANALYSIS_MODEL=

# Optional local Transformers translation (example: English -> Vietnamese).
# Install transformers, sentencepiece and torch separately before enabling.
# TRANSLATION_PROVIDER=transformers
# TRANSLATION_MODEL=Helsinki-NLP/opus-mt-en-vi
# TRANSFORMERS_TARGET_LANGUAGE=Tiếng Việt
# TRANSFORMERS_DEVICE=auto

# ── Dubbing ─────────────────────────────────────────────────────────
# The voice engine. `edge` is Microsoft's free neural endpoint (pip install
# edge-tts, already in requirements.txt); `mock` is a stand-in used by the tests.
TTS_PROVIDER=edge
# vi-VN-HoaiMyNeural (female) and vi-VN-NamMinhNeural (male) are the Vietnamese
# voices. Any voice the provider offers works — `edge-tts --list-voices` lists them.
TTS_VOICE=vi-VN-HoaiMyNeural
# Lines synthesised at once. Speech synthesis is network-bound, so a strictly
# serial pass would spend most of a feature-length video waiting; a burst much
# larger than this gets throttled by the free endpoint.
TTS_CONCURRENCY=4
TTS_TIMEOUT_SECONDS=60

# How loud the original audio stays under the dub. 0 silences it entirely.
DUB_ORIGINAL_GAIN=0.25
# A line too long for its cue is sped up first. Above ~1.25 a voice stops
# sounding like a person in a hurry and starts sounding like a fast-forward.
DUB_MAX_SPEEDUP=1.25
# If speeding it up is not enough, a line may run this far into the silence
# that follows its cue.
DUB_MAX_SPILL_SECONDS=1.2
# Which of those two is tried first. `speed` keeps the dub tight against the
# subtitles and speeds lines up even when there is silence to spare; `natural`
# spends that silence first and only speeds up what still does not fit. On a
# 20-line sample, `speed` sped 8 lines up and spilled none. It can also be sent
# per run in the dub request, so both can be compared without a restart.
DUB_PREFER=speed
# The last resort for a line neither trick can fit: the LLM rewrites it shorter
# and it is recorded again. Costs provider calls; false leaves it merely rushed.
DUB_SHORTEN_WITH_LLM=true

# Optional ffmpeg executable used for soft-subtitle muxing and dub mixing.
FFMPEG_BINARY=ffmpeg
MAX_UPLOAD_MB=2048

# Server log verbosity: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# How many jobs run at once; the rest queue. One local transcription already
# saturates a CPU, so raise this only when the providers are remote.
MAX_CONCURRENT_JOBS=2

# Whisper models kept in RAM at once. large-v3 int8 is roughly 1.5 GB each, so
# the default reloads on a model switch instead of holding several.
WHISPER_MODEL_CACHE=1

# Retries for transient provider failures (connection errors, 5xx).
HTTP_RETRIES=2
# A 429 is retried on its own budget, waiting as long as the provider's
# Retry-After header asks for (exponential backoff up to a minute otherwise).
HTTP_RATE_LIMIT_RETRIES=5
LLM_TIMEOUT_SECONDS=180

# Seconds between two LLM calls. A translation is a long burst of small
# requests, so set this to just over the provider's requests-per-second limit
# (Mistral's free tier: 1.1). 0 lets a local model run flat out.
LLM_MIN_INTERVAL_SECONDS=0

# Responses smaller than this skip gzip: the header would cost more than the
# compression saves. The event stream and the media routes are never gzipped.
GZIP_MINIMUM_SIZE=800

# How long a browser may reuse a frontend file without asking the server.
# 0 keeps `no-cache`, which is what development needs — an edited file loads on
# the next reload. Frontend assets carry no content hash in their names, so any
# other value means an update stays invisible for that long: raise it only on a
# deployment you redeploy on purpose, and hard-refresh after each deploy.
STATIC_CACHE_SECONDS=0
